/* ============================================================
   音乐播放器 QSS 样式表
   设计风格：深色毛玻璃 + 红色点缀
   配色参考：网易云音乐风格
   ============================================================ */

/* 主窗口背景 - 深色渐变 */
QMainWindow {
    background-color: #1a1a2e;
}

/* 标题文字 */
QLabel#name_label {
    color: #ffffff;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* ==================== 3. 专辑封面区域 ==================== */
QLabel#Cover_label {
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
}


/* ==================== 5. 播放控制按钮 ==================== */

/* 所有控制按钮通用样式 */
QPushButton {
    background: transparent;
    border: none;
    border-radius: 50%;
    color: #d0d0e0;
    font-size: 22px;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

QPushButton:pressed {
    background: rgba(255, 255, 255, 0.14);
}


/* 播放/暂停按钮 - 突出显示 */
QPushButton#pBtn_Pause {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ec4141,
                                stop:1 #d93b3b);
    border: none;
    border-radius: 50%;
    color: #ffffff;
    font-size: 26px;
}

QPushButton#pBtn_Pause:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #f54a4a,
                                stop:1 #e04040);
    box-shadow: 0 4px 20px rgba(236, 65, 65, 0.35);
}

QPushButton#pBtn_Pause:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #c93535,
                                stop:1 #b83030);
}


/* 喜欢/收藏按钮 */
QPushButton#pBtn_SetLove {
    background: transparent;
    border: none;
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.40);
    font-size: 18px;
}

QPushButton#pBtn_SetLove:hover {
    color: #ec4141;
    background: rgba(236, 65, 65, 0.12);
}

QPushButton#pBtn_SetLove[active="true"] {
    color: #ec4141;
}

/* 喜欢按钮图标由代码 setIcon 驱动，此处不再用 border-image，避免重复叠加两个爱心 */

QPushButton#pBtn_mod:checked
{
    border-image:url(:/Music/Ui/随机播放.png);
}
QPushButton#pBtn_mod:!checked
{
    border-image:url(:/Music/Ui/单曲循环.png);
}
QPushButton#pBtn_Pause:!checked
{
    border-image:url(:/Music/Ui/播放中.png);
}
QPushButton#pBtn_Pause:checked
{
    border-image:url(:/Music/Ui/暂停.png);
}


/* ==================== 6. 进度条 (QSlider) ==================== */

QSlider::groove:horizontal {
    height: 4px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ec4141,
                                stop:1 #f06292);
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.30);
}

QSlider::handle:horizontal:hover {
    background: #f0f0f0;
    width: 16px;
    height: 16px;
    margin: -6px 0;
}

QSlider::handle:horizontal:pressed {
    background: #ec4141;
    width: 16px;
    height: 16px;
    margin: -6px 0;
}

/* 进度时间标签 */
QLabel#currentTime,
QLabel#totalTime {
    color: rgba(255, 255, 255, 0.50);
    font-family: "Consolas", "Monaco", monospace;
    font-size: 12px;
    font-weight: 400;
}


/* ==================== 8. 播放列表 (QListWidget / QListView) ==================== */

QListWidget {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 4px 0;
    color: rgba(255, 255, 255, 0.75);
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 13px;
    outline: none;
}

QListWidget::item {
    padding: 8px 16px;
    border-radius: 4px;
    background: transparent;
}

QListWidget::item:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}

QListWidget::item:selected {
    background: rgba(236, 65, 65, 0.20);
    color: #ffffff;
    border-left: 3px solid #ec4141;
}

QListWidget::item:selected:!active {
    background: rgba(236, 65, 65, 0.12);
}

/* 播放列表滚动条 */
QListWidget::verticalScrollBar {
    width: 6px;
    background: transparent;
    border-radius: 3px;
}

QListWidget::verticalScrollBar::handle {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    min-height: 30px;
}

QListWidget::verticalScrollBar::handle:hover {
    background: rgba(255, 255, 255, 0.25);
}

QListWidget::verticalScrollBar::add-line,
QListWidget::verticalScrollBar::sub-line {
    height: 0;
    background: none;
}


/* ==================== 9. 播放模式按钮 ==================== */

QPushButton#pBtn_mod {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.40);
    font-size: 14px;
}

QPushButton#pBtn_mod:hover {
    color: rgba(255, 255, 255, 0.70);
    background: rgba(255, 255, 255, 0.06);
}

QPushButton#pBtn_mod[active="true"] {
    color: #ec4141;
}

