/* ===== 主窗口背景：模拟晴朗天空渐变 ===== */
QMainWindow {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #74b9ff, stop: 0.5 #a8d8ea, stop: 1 #dfe6e9);
}

/* ===== 1. 卡片容器（QGroupBox） ===== */
QGroupBox {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 40px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-top-color: rgba(255, 255, 255, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.08);
    padding: 28px 24px 24px 24px;
    margin-top: 16px;
    /* 柔和阴影 */
    box-shadow: 0 12px 40px rgba(0, 20, 40, 0.15);
}

/* 隐藏标题（保留占位） */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: transparent;
    background: transparent;
    border: none;
    height: 0px;
    width: 0px;
}

/* 卡片悬停：略微提亮 */
QGroupBox:hover {
    background: rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.6);
}

/* ========== 基础按钮（玻璃质感） ========== */
QPushButton {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 40px;
    padding: 12px 32px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-bottom: 2px solid rgba(255, 255, 255, 0.15);
    color: #1e3c5f;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.5px;
    /* 柔和阴影，让按钮轻微浮起 */
    box-shadow: 0 4px 15px rgba(0, 20, 40, 0.08);
}

/* 悬停：更透亮，阴影加深 */
QPushButton:hover {
    background: rgba(255, 255, 255, 0.45);
    border-color: rgba(255, 255, 255, 0.8);
    box-shadow: 0 8px 30px rgba(0, 20, 40, 0.15);
}

/* 按下：内凹效果 */
QPushButton:pressed {
    background: rgba(200, 225, 255, 0.5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-top: 13px;      /* 下移1px模拟按下 */
    padding-bottom: 11px;
    box-shadow: 0 2px 8px rgba(0, 20, 40, 0.05);
}

/* ===== 分割线 ===== */
Line {
    background: rgba(255, 255, 255, 0.25);
    max-height: 1px;
    min-height: 1px;
    margin-top: 12px;
    margin-bottom: 12px;
    border: none;
}

/* ===== 2. 顶部：星期 ===== */
QLabel#label_day1_week,
QLabel#label_day2_week,
QLabel#label_day3_week,
QLabel#label_day4_week {
    font-family: "Inter", "Segoe UI", system-ui, sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #1e3c5f;
    letter-spacing: 1.5px;
    background: transparent;
    padding: 0px;
}

/* ===== 3. 顶部：日期 ===== */
QLabel#label_day1_data,
QLabel#label_day2_data,
QLabel#label_day3_data,
QLabel#label_day4_data{
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #2c5a7a;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 30px;
    padding: 4px 16px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    letter-spacing: 0.3px;
}

/* ===== 7. 底部：风向 ===== */
QLabel#label_day1_win,
QLabel#label_day2_win,
QLabel#label_day3_win,
QLabel#label_day4_win{
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #1f4b6e;
    background: rgba(200, 230, 255, 0.45);
    border-radius: 30px;
    padding: 6px 18px;
    qproperty-alignment: AlignCenter;
    border: 1px solid rgba(255, 255, 255, 0.4);
    letter-spacing: 0.2px;
}

/* ===== 8. 底部：风速 ===== */
QLabel#label_day1_winSpeed,
QLabel#label_day2_winSpeed,
QLabel#label_day3_winSpeed,
QLabel#label_day4_winSpeed{
    font-family: "Roboto Mono", "Consolas", monospace;
    font-size: 16px;
    font-weight: 600;
    color: #1f6e4a;
    background: rgba(200, 255, 220, 0.35);
    border-radius: 30px;
    padding: 6px 18px;
    qproperty-alignment: AlignCenter;
    border: 1px solid rgba(200, 255, 220, 0.5);
    letter-spacing: 0.2px;
}

/* 风向/风速悬停效果 */
QLabel#label_day1_win,
QLabel#label_day2_win,
QLabel#label_day3_win,
QLabel#label_day4_win:hover {
    background: rgba(200, 230, 255, 0.65);
    border-color: rgba(255, 255, 255, 0.6);
}

QLabel#label_day1_winSpeed,
QLabel#label_day1_winSpeed,
QLabel#label_day1_winSpeed,
QLabel#label_day1_winSpeed:hover {
    background: rgba(200, 255, 220, 0.55);
    border-color: rgba(200, 255, 220, 0.7);
}

/* ===== 6. 天气描述 ===== */
QLabel#label_day1_des,
QLabel#label_day2_des,
QLabel#label_day3_des,
QLabel#label_day4_des{
    font-family: "Georgia", "Times New Roman", "Songti SC", serif;
    font-size: 14px;
    font-weight: 400;
    color: #1e3f5c;
    background: rgba(255, 255, 255, 0.45);
    border-radius: 40px;
    padding: 6px 24px;
    qproperty-alignment: AlignCenter;
    margin-top: 8px;
    margin-bottom: 8px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    letter-spacing: 0.5px;
}

/* ===== 5. 中部：温度 ===== */
QLabel#label_day1_tmp,
QLabel#label_day2_tmp,
QLabel#label_day3_tmp,
QLabel#label_day4_tmp {
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 25px;
    font-weight: 700;
    color: #0f2b44;
    background: transparent;
    qproperty-alignment: AlignCenter;
    letter-spacing: 0.5px;
    padding-right: 0px;
}

/* ===== 时间标签（小号、精致） ===== */
QLabel#label_Time,
QLabel#label_location,
label,
label_3{
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 18px;               /* 从 32px 减小到 18px */
    font-weight: 600;              /* SemiBold，避免太细 */
    color: #1e3c5f;
    background: transparent;
    qproperty-alignment: AlignVCenter;
    letter-spacing: 0.3px;
    padding: 0px;
}


/* ============================================================
   5. （可选）为“此刻”卡片容器添加特殊样式
   如果你用 QGroupBox 包裹当前天气，可以如下加强
   ============================================================ */
QGroupBox#groupBox_5 {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 rgba(79, 172, 254, 0.25),
                                stop: 1 rgba(0, 198, 251, 0.15));
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: rgba(255, 255, 255, 0.5);
    border-bottom-color: rgba(0, 0, 0, 0.1);
    box-shadow: 0 20px 60px rgba(79, 172, 254, 0.25);
    padding: 40px 36px 36px 36px;
    margin-top: 24px;
    border-radius: 56px;
}

/* ============================================================
   1. 当前温度 (label_now_tmp) —— 超大、发光
   ============================================================ */
QLabel#label_now_tmp {
    font-family: "Inter", "Roboto Mono", "Helvetica Neue", monospace;
    font-size: 40px;              /* 醒目的大号 */
    font-weight: 900;
    color: #ffffff;
    background: transparent;
    qproperty-alignment: AlignVCenter;
    padding-right: 12px;
    letter-spacing: -3px;
}

/* ============================================================
   2. 当前天气图标 (label_now_img) —— 大尺寸 + 动态悬浮光晕
   ============================================================ */
QLabel#label_now_img {
    font-size: 40px;             /* 比普通图标大 */
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    padding: 16px;
    qproperty-alignment: AlignCenter;
    border: 1px solid rgba(255, 255, 255, 0.15);
}

/* 悬停：增强光晕 */
QLabel#label_now_img:hover {
    background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.05) 80%);
    border-color: rgba(255, 255, 255, 0.3);
}

/* ============================================================
   3. 当前天气描述 (label_now_des) —— 醒目的胶囊背景
   ============================================================ */
QLabel#label_now_des {
    font-family: "Georgia", "Times New Roman", "Songti SC", serif;
    font-size: 24px;
    font-weight: 600;
    color: #ffffff;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 rgba(79, 172, 254, 0.7),
                                stop: 1 rgba(0, 198, 251, 0.7));
    border-radius: 60px;
    padding: 12px 40px;
    qproperty-alignment: AlignCenter;
    border: 1px solid rgba(255, 255, 255, 0.25);
    letter-spacing: 1.2px;
    backdrop-filter: blur(4px);   /* 若支持，让背景模糊 */
}

/* ============================================================
   4. 当前风向 (label_now_win) 与 风速 (label_now_winSpeed)
   —— 统一风格，但颜色区分
   ============================================================ */
QLabel#label_now_win,
QLabel#label_now_winSpeed {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 600;
    padding: 10px 28px;
    border-radius: 40px;
    qproperty-alignment: AlignCenter;
    letter-spacing: 0.5px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
}

/* 风向：浅蓝调 */
QLabel#label_now_win {
    background: rgba(70, 130, 255, 0.2);
    border-color: rgba(70, 130, 255, 0.25);
}

/* 风速：清新绿调 */
QLabel#label_now_winSpeed {
    background: rgba(0, 200, 100, 0.15);
    border-color: rgba(0, 200, 100, 0.2);
}

/* 悬停效果：透亮 */
QLabel#label_now_win:hover {
    background: rgba(70, 130, 255, 0.35);
    border-color: rgba(70, 130, 255, 0.4);
}
QLabel#label_now_winSpeed:hover {
    background: rgba(0, 200, 100, 0.3);
    border-color: rgba(0, 200, 100, 0.35);
}





/* ===== 4. 中部：天气图标 ===== */
QLabel#label_day1_img,
QLabel#label_day2_img
QLabel#label_day3_img
QLabel#label_day4_img,{
    font-size: 72px;
    background: transparent;
    qproperty-alignment: AlignCenter;
}

/* 图标悬停光晕 */
QLabel#label_day1_img,
QLabel#label_day2_img,
QLabel#label_day3_img,
QLabel#label_day4_img:hover {
    background: radial-gradient(circle, rgba(255, 255, 255, 0.4) 0%, transparent 70%);
    border-radius: 50%;
}





