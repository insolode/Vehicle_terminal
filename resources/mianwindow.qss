/***********************************************************************************************************/
/***********************************     QPushButton   *****************************************************/
/***********************************************************************************************************/

QMainWindow#MainWindow {
        border-image: url(:/resources/Picture/desktop.jpg);
}


QPushButton {
    border: none;
    border-radius: 6px;
    color: #ffffff;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 13px;
    font-weight: 500;
    padding: 10px 28px;
}

/* 悬停：颜色变亮，并增加微弱的阴影效果（需Qt支持） */
QPushButton:hover {
    background: #4d9bff;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

/* 按下：颜色明显变深 */
QPushButton:pressed {
    background: #0f5ec7;
    padding-top: 12px;
    padding-bottom: 8px;              /* 同样模拟按压下沉 */
}

/* 禁用 */
QPushButton:disabled {
    background: #e5e7eb;
    color: #9ca3af;
}


/***********************************************************************************************************/
/****************************************     QLabel   *****************************************************/
/***********************************************************************************************************/

QLabel {
    /* 字体 */
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 14px;
    font-weight: 500;

    /* 颜色 – 改为浅冷白，在深蓝背景上更显眼 */
    color: #E8ECF5;

    /* 对齐方式 */
    text-align: center;
    alignment: center;

    /* 上下留白 – 与按钮保持舒适距离 */
    margin-top: 6px;

}

/* 标签被禁用时的表现（可与按钮状态同步） */
QLabel:disabled {
    color: #a0aec0;
}

QLabel#label_Time {
    /* 字体：加粗、大号、衬线体（更显庄重） */
    font-family: "Microsoft YaHei", "PingFang SC", "Georgia", serif;
    font-size: 48px;
    font-weight: bold;

    /* 文字颜色：金色渐变，整体提亮，更醒目 */
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                          stop:0 #FFE24D, stop:1 #FFF3B0);

    qproperty-alignment: AlignCenter;
    font-style: normal;

    /* 背景：深蓝到深灰的径向渐变，营造深邃天空感 */
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
                                      fx:0.5, fy:0.5,
                                      stop:0 #1a2a6c, stop:0.6 #0f172a, stop:1 #0a0f1a);

    padding: 20px 30px;
    border-radius: 15px;
    border: 1px solid rgba(255, 255, 255, 0.15);

    qproperty-effect: drop-shadow(0px 4px 8px rgba(0,0,0,0.6));
}

QLabel#label_Date {
    /* 字体：纤细、优雅，大小适中（约为时间的一半） */
    font-family: "Microsoft YaHei", "PingFang SC", "Georgia", serif;
    font-size: 22px;
    font-weight: normal;

    /* 文字颜色：淡金渐变，提亮后更清晰 */
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                          stop:0 #FFF0B8, stop:1 #E8D89A);

    /* 背景：半透明深色，衬出文字，但不抢眼 */
    background-color: rgba(10, 20, 40, 0.5);
    border-radius: 10px;
    padding: 8px 20px;

    /* 底部装饰线：提升精致感 */
    border-bottom: 2px solid rgba(255, 215, 0, 0.4);

    qproperty-alignment: AlignCenter;
    font-style: normal;
    letter-spacing: 1.5px;
}

/* ========== 温度/湿度显示控件（QLabel）统一样式 ========== */
QLabel#label_temp_n,
QLabel#label_temp,
QLabel#label_humi_n,
QLabel#label_humi{
    font-family: "Microsoft YaHei", "PingFang SC", "Arial", sans-serif;
    font-size: 16px;
    font-weight: 600;

    background-color: rgba(0, 10, 30, 0.6);  /* 深蓝黑半透明 */
    border-radius: 8px;
    padding: 6px 16px;
    color: #F0E6A0;               /* 统一使用淡金色文字，便于阅读 */

    qproperty-alignment: AlignCenter;
    letter-spacing: 0.5px;
}
